# ============================================================
# StatBridge API keys
# Copy this file to .env and fill in the real keys.
# NEVER commit/share the real .env.
# ============================================================

# KOSIS numeric statistics API
KOSIS_API_KEY=
KOSIS_RATE_LIMIT_PER_MINUTE=50
KOSIS_TIMEOUT=45

# NAVER Cloud / CLOVA Studio
# Preferred name. NCP_API_KEY and CLOVA_STUDIO_API_KEY are also accepted as fallbacks.
NCP_CLOVA_API_KEY=
NCP_TIMEOUT=60
NCP_CLOVA_BASE_URL=https://clovastudio.stream.ntruss.com

# HCX-003: natural Korean -> statistical-language classifier only.
# Public CLOVA Studio API: Chat Completions v1.
NCP_CLASSIFIER_MODEL=HCX-003
NCP_CLASSIFIER_API_VERSION=v1
NCP_CLASSIFIER_URL=

# HCX-007: main StatBridge agent, clarification wording, final answer.
# Current public CLOVA Studio API: Chat Completions v3.
NCP_MAIN_MODEL=HCX-007
NCP_MAIN_API_VERSION=v3
NCP_MAIN_URL=
NCP_MAIN_THINKING_EFFORT=low

# Output / editing only. Classifier and embeddings continue to use NCP.
STATBRIDGE_OUTPUT_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_CHART_MODEL=gpt-5.4
OPENAI_CHART_TIMEOUT=90

# START_STATBRIDGE.cmd injects portable runtime data paths.
NCP_EMBEDDING_URL=https://clovastudio.stream.ntruss.com/v1/api-tools/embedding/v2/
NCP_RERANKER_URL=https://clovastudio.stream.ntruss.com/v1/api-tools/reranker
STATBRIDGE_HYBRID_RETRIEVAL=1
# Optional override; default is .venv/cache/vector_store_349.
# STATBRIDGE_VECTOR_PATH=
STATBRIDGE_VECTOR_TOP_K=24
STATBRIDGE_RERANK_TOP_K=12
STATBRIDGE_MIN_FINAL_SCORE=0.42
STATBRIDGE_MIN_SCORE_GAP=0.06
STATBRIDGE_MIN_RULE_SCORE=25

# Optional TypeSafe Jev auxiliary classifier. It only verifies the number of
# independent statistical metrics; every failure falls back to the HCX result.
TYPESAFE_API_KEY=
# Preferred Jev key name. The legacy TYPESAFE_API_KEY is also accepted.
JEV_API_KEY=
TYPESAFE_ENDPOINT=https://api.typesafe.ai
STATBRIDGE_JEV_MODEL=jev-preview
STATBRIDGE_JEV_ENABLED=1
STATBRIDGE_JEV_TIMEOUT=10

# Optional reviewed original-PDF excerpts JSONL; leave empty without verified evidence.
STATBRIDGE_REPORT_PASSAGES=

# Optional Langfuse export. Local timings work without these keys.
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
# Optional: local1 / statbridge1; inferred from the runtime directory if blank.
STATBRIDGE_TRACE_ENVIRONMENT=
