{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StatBridge E2E workflow case",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "schema_version", "mode", "split", "group_id", "tier", "tags", "input", "expected", "evidence", "eligible_for_scoring", "qualitative_applicable", "review"],
  "properties": {
    "id": {"type": "string", "pattern": "^SBE-[0-9]{4}$"},
    "schema_version": {"const": "1.0"},
    "mode": {"enum": ["query_output", "derived", "report", "follow_up", "edit"]},
    "split": {"enum": ["dev", "test"]},
    "group_id": {"type": "string", "minLength": 1},
    "tier": {"enum": ["A", "B", "C"]},
    "tags": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "input": {
      "type": "object",
      "required": ["query", "reference_date", "prior_turns"],
      "properties": {
        "query": {"type": "string", "minLength": 1},
        "reference_date": {"type": "string", "format": "date"},
        "prior_turns": {"type": "array", "items": {"type": "object", "required": ["role", "text"],
          "properties": {"role": {"enum": ["user", "assistant"]}, "text": {"type": "string"}}}},
        "base_case_id": {"type": "string", "pattern": "^SBE-[0-9]{4}$"},
        "actions": {"type": "array", "items": {"type": "object", "required": ["kind"],
          "properties": {"kind": {"enum": ["confirm_period", "report", "edit"]},
            "start": {"type": "string"}, "end": {"type": "string"},
            "report_kind": {"enum": ["chart_brief", "interpret", "conversation"]},
            "operation": {"enum": ["set_title", "set_legend", "set_transform", "filter_period"]}}}}
      }
    },
    "expected": {
      "type": "object",
      "required": ["decision"],
      "properties": {
        "decision": {"enum": ["resolved", "unresolved_probe"]},
        "output_kind": {"enum": ["graph", "table"]},
        "series": {"type": "array", "items": {"type": "object",
          "required": ["table_id", "item_id", "classifications", "frequency"],
          "properties": {"table_id": {"type": "string"}, "item_id": {"type": "string"},
            "classifications": {"type": "object"}, "frequency": {"enum": ["M", "Q", "A"]}}}},
        "periods": {"type": "array", "items": {"type": "string"}},
        "oracle_sha256": {"type": ["string", "null"]},
        "numeric_scored": {"type": "boolean"},
        "variant_of": {"type": "string"},
        "base_case_id": {"type": "string"},
        "operation": {"enum": ["difference", "growth", "yoy"]},
        "sources": {"type": "array"},
        "report_kind": {"enum": ["chart_brief", "interpret", "conversation"]},
        "revision": {"type": "integer", "minimum": 0},
        "require_citations": {"type": "boolean"},
        "preserved": {"type": "array", "items": {"type": "string"}},
        "expected_state": {"type": "object"},
        "reason": {"type": "string"}
      }
    },
    "evidence": {"type": "object", "required": ["research_type_id"]},
    "eligible_for_scoring": {"type": "boolean"},
    "qualitative_applicable": {"type": "array", "uniqueItems": true,
      "items": {"enum": ["facts", "completeness", "clarity", "source_limits", "visual", "conversation_recovery"]}},
    "review": {"type": "object", "required": ["human_approved", "reviewer"],
      "properties": {"human_approved": {"const": false}, "reviewer": {"type": "null"}}}
  }
}
