{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClaBi KOSIS Golden Set v2 Draft Case",
  "type": "object",
  "required": ["case_id", "split", "primary_type", "tags", "leakage_group", "catalog_version", "conversation", "gold", "annotation", "review", "provenance"],
  "properties": {
    "case_id": {"type": "string", "pattern": "^GS-[0-9]{4}$"},
    "split": {"enum": ["dev", "validation", "locked_test"]},
    "primary_type": {"enum": ["clear_single_table", "colloquial_alias", "ambiguous_metric", "multi_indicator_table", "conditions", "no_match_out_of_scope", "conversation_followup"]},
    "tags": {"type": "array", "items": {"type": "string"}},
    "leakage_group": {"type": "string"},
    "catalog_version": {"type": "string"},
    "conversation": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["role", "text"], "properties": {"role": {"enum": ["user", "assistant"]}, "text": {"type": "string", "minLength": 1}}, "additionalProperties": false}},
    "gold": {
      "type": "object",
      "required": ["input", "interpretation", "concepts", "ambiguity", "clarification", "data_strategy", "tool_plan", "plan_validation", "retrieval", "handoff"],
      "properties": {
        "input": {"type": "object", "required": ["original_query", "prior_turns", "required_context", "overridden_context", "must_preserve_context_fields", "must_overwrite_context_fields"]},
        "interpretation": {"type": "object", "required": ["acceptable_intents", "slots", "unspecified_slots", "slot_provenance", "time_reference_policy"]},
        "concepts": {"type": "object", "required": ["source_query_text", "acceptable_candidates", "alternative_candidates", "candidate_evidence", "must_preserve_ambiguity", "candidate_status", "evidence_requirements"]},
        "ambiguity": {"type": "object", "required": ["present", "conflicts", "must_not_ask"]},
        "clarification": {"type": "object", "required": ["expected", "must_resolve", "acceptable_question_criteria", "answer_branches"]},
        "data_strategy": {"type": "object", "required": ["type", "required_checks", "merge_allowed", "calculation_required"]},
        "tool_plan": {"type": "object", "required": ["expected_next_action", "allowed_tools", "conditionally_allowed_tools", "planned_tools", "required_tools", "forbidden_tools", "required_arguments_by_tool", "required_order", "validation_conditions"]},
        "plan_validation": {"type": "object", "required": ["expected_result", "must_reject", "must_check", "case_specific_preconditions"]},
        "retrieval": {"type": "object", "required": ["expected_status", "status_is_proposal", "candidates", "acceptable_table_ids", "no_match_reason", "search_scope", "acceptable_answer_range"]},
        "handoff": {"type": "object", "required": ["target", "expected_status", "required_fields", "expected_payload"]}
      }
    },
    "annotation": {"type": "object", "required": ["evidence", "review_status", "reviewer", "reviewed_at", "notes"], "properties": {"evidence": {"type": "array", "items": {"type": "string"}}, "review_status": {"enum": ["draft", "review_required", "needs_adjudication", "approved", "excluded"]}, "reviewer": {"type": ["string", "null"]}, "reviewed_at": {"type": ["string", "null"]}, "notes": {"type": "string"}}},
    "review": {"type": "object", "required": ["decision", "approved_table_ids", "edited_gold", "reviewer", "reviewed_at", "review_notes"], "properties": {"decision": {"enum": ["승인", "수정", "보류", "제외", null]}, "approved_table_ids": {"type": "array", "items": {"type": "string"}}, "edited_gold": {}, "reviewer": {"type": ["string", "null"]}, "reviewed_at": {"type": ["string", "null"]}, "review_notes": {"type": ["string", "null"]}}},
    "provenance": {"type": "object", "required": ["source_case_id", "source_dataset", "source_review_status", "migration_status"]}
  },
  "additionalProperties": true
}
